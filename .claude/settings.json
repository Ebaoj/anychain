{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "ANYCHAIN_REPO=\"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_commit.sh\"",
            "timeout": 120,
            "statusMessage": "anychain: running tests before commit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ANYCHAIN_REPO=\"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/tests_after_edit.sh\"",
            "timeout": 120,
            "statusMessage": "anychain: running tests after edit"
          }
        ]
      }
    ]
  }
}
